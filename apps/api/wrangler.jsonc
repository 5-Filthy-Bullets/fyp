{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fyp-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "BETTER_AUTH_LOG_LVL": "error",
    "BETTER_AUTH_URL": "https://fyp-api.razobeckett.workers.dev",
    "WEB_URL": "https://fyp-web.pages.dev"
  },
  // Daily ticket reminders (unassigned + stale). Pair with the `scheduled`
  // handler in src/index.ts. Mail itself needs SENDGRID_API_KEY (secret) and
  // EMAIL_FROM (a Single Sender verified address) to actually deliver.
  "triggers": {
    "crons": ["0 9 * * *"]
  },
  // "kv_namespaces": [
